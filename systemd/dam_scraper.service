[Unit]
Description=Maharashtra Dam Water Storage Daily Scraper & Database Ingestion
After=network.target

[Service]
Type=oneshot
User=parth
WorkingDirectory=/home/parth/SY/DBMS/CP
ExecStart=/usr/bin/python3 /home/parth/SY/DBMS/CP/scraper/daily_dam_worker.py --once --days 3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
